# ============================================
# MentorMyBoard - Environment Variables
# ============================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.

# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://consulting.mentormyboard.com
NEXT_PUBLIC_SITE_NAME="MentorMyBoard"

# ---- Database (MongoDB Atlas) ----
# Format: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://info_db_user:YMfZ0MmbJK43VSDy@mmbconsultancy.lp1gutm.mongodb.net/?appName=MMBConsultancy
MONGODB_DB_NAME=mentormyboard

# ---- Email (Brevo) ----
# Get your API key from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
# Sender — must be a verified sender in Brevo (Settings > Senders & IPs)
EMAIL_FROM="MentorMyBoard <no-reply@mentormyboard.com>"
# Business inbox that receives new inquiries
EMAIL_TO_BUSINESS=info@mentormyboard.com
# Optional CC for internal team
EMAIL_CC_INTERNAL=divya@mentormyboard.com

# ---- WhatsApp ----
# E.164 format WITHOUT + or spaces. Example: 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=917304145928
NEXT_PUBLIC_WHATSAPP_DEFAULT_MESSAGE="Hello MentorMyBoard, I'd like to discuss a board advisory mandate."

# ---- Rate Limiting (Upstash Redis - optional, falls back to in-memory) ----
# Sign up at https://upstash.com — free tier is sufficient
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Admin (basic auth for /admin/submissions) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-strong-password

# ---- Anti-spam (Cloudflare Turnstile - optional but recommended) ----
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Zoho CRM (India data center) ----
# Create a Self-Client at https://api-console.zoho.in → Self Client → Generate Code
# Scopes needed: ZohoCRM.modules.leads.ALL
# Then exchange the grant token once via:
#   POST https://accounts.zoho.in/oauth/v2/token
#     ?code=<grant_token>&client_id=...&client_secret=...&redirect_uri=https://consulting.mentormyboard.com&grant_type=authorization_code
# Save the refresh_token from the response here.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# ---- Node Environment ----
NODE_ENV=development
